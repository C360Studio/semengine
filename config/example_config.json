{
  "platform": {
    "org": "c360",
    "id": "mavlink-demo",
    "type": "ground-station"
  },
  "nats": {
    "urls": ["nats://localhost:4222"],
    "jetstream": { "enabled": true }
  },
  "services": {
    "message-logger": {"enabled": true, "config": {}},
    "discovery": {"enabled": true, "config": {}}
  },
  "components": {
    "graph-ingest": {
      "type": "processor",
      "name": "graph-ingest",
      "enabled": true,
      "config": {
        "ports": {
          "inputs": [
            {
              "name": "entity_stream",
              "config": {"kind": "jetstream", "stream_name": "ENTITY", "subjects": ["entity.>"], "deliver_policy": "all"}
            },
            {
              "name": "mutations",
              "required": true,
              "config": {
                "kind": "nats-request",
                "subject": "graph.mutation.>",
                "interface": {"type": "semengine.graph.mutation", "version": "v1"}
              }
            }
          ],
          "outputs": [
            {
              "name": "entity_states",
              "config": {"kind": "kv-write", "bucket": "ENTITY_STATES"}
            }
          ]
        },
        "enable_hierarchy": false,
        "ingest_lanes": 8
      }
    }
  }
}
