    "limit": 0
   },
   "expect_none": [
    "_test.go"
   ],
   "expect_ids": [
    "c360.semengine.pkg.markdown.section.s0058",
    "c360.semengine.pkg.markdown.section.s1260"
   ],
   "expect_no_ids": [
    "c360.semengine.openspec.markdown.section.s0033",
    "c360.semengine.openspec.markdown.section.s0717"
   ],
   "why": "An excluded word removes rather than demotes: no section holding test survives, so no hit names a _test.go file."
  },
  {
   "id": "X02",
   "band": "exclusion",
   "args": {
    "query": "retry backoff",
    "limit": 0
   },
   "expect_any": [
    "_test.go"
   ],
   "expect_ids": [
    "c360.semengine.openspec.markdown.section.s0033",
    "c360.semengine.openspec.markdown.section.s0717",
    "c360.semengine.pkg.markdown.section.s0058",
    "c360.semengine.pkg.markdown.section.s1260"
   ],
   "why": "Without the exclusion the sections naming _test.go are found, so X01 removes something."
  },
  {
   "id": "X03",
   "band": "exclusion",
   "twin": "X04",
   "args": {
    "query": "natsfixture -\"t.Parallel\"",
    "limit": 0
   },
   "expect_none": [
    "t.Parallel"
   ],
   "why": "An excluded phrase removes every section holding it."
  },
  {
   "id": "X04",
   "band": "exclusion",
   "args": {
    "query": "natsfixture",
    "limit": 0
   },
   "expect_any": [
    "t.Parallel"
   ],
   "why": "Without the exclusion some hits hold t.Parallel, so X03 removes something."
  },
  {
   "id": "X05",
   "band": "exclusion",
   "twin": "P01",
   "args": {
    "query": "go test -race",
    "limit": 0
   },
   "expect_no_ids": [
    "c360.semengine.openspec.markdown.section.s0061",
    "c360.semengine.openspec.markdown.section.s0063"
   ],
   "why": "Unquoted, a single leading - excludes: a section holding go test -race is removed."
  },
  {
   "id": "X06",
   "band": "exclusion",
   "twin": "X05",
   "args": {
    "query": "go test --race",
    "limit": 0
   },
   "expect_ids": [
    "c360.semengine.openspec.markdown.section.s0061",
    "c360.semengine.openspec.markdown.section.s0063"
   ],
   "why": "A double - is text, not an exclusion: the same sections are found."
  },
  {
