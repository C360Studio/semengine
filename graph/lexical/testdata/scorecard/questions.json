   ],
   "why": "A plural query finds a section holding only the singular."
  },
  {
   "id": "W02",
   "band": "plural",
   "args": {
    "query": "indexes",
    "limit": 0
   },
   "expect_ids": [
    "c360.semengine.openspec.markdown.section.s0005"
   ],
   "why": "A plural in es after x finds a section holding only index."
