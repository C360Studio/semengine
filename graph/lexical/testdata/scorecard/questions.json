{
 "version": 1,
 "corpus": "corpus.jsonl.gz: 2,000 sections of this repository's Markdown, frozen",
 "grading": "see README.md",
 "questions": [
  {
   "id": "P01",
   "band": "phrase",
   "args": {
    "query": "\"go test -race\"",
    "limit": 0
   },
   "expect_hits_match": "(?i)(^|[^\\pL\\pN])go[^\\pL\\pN]+test[^\\pL\\pN]+race([^\\pL\\pN]|$)",
   "why": "A quoted flag stays whole: exactly the sections holding go, test and race next to each other in one field."
  },
  {
   "id": "P02",
   "band": "phrase",
   "args": {
    "query": "\"task verify\"",
    "limit": 0
   },
   "expect_hits_match": "(?i)(^|[^\\pL\\pN])task[^\\pL\\pN]+verify([^\\pL\\pN]|$)",
   "why": "A two-word command as a phrase: exactly the sections holding it."
  },
  {
   "id": "P03",
   "band": "phrase",
   "args": {
    "query": "\"-count=1\"",
    "limit": 0
   },
   "expect_hits_match": "(?:(?:^|[^\\pL\\pN])[cC]|\\p{Ll}C)ounts?[^\\pL\\pN]+1(?:[^\\pL\\pN]|$)",
   "why": "A quoted flag with a value: quoting keeps the leading - from excluding. The words count and 1 also stand next to each other in counts: [1 and in ErrorCount` +1, which the identifier split and the plural rule hold as count 1."
  },
  {
   "id": "P04",
   "band": "phrase",
   "args": {
    "query": "\"graph.ingest.query\"",
    "limit": 0
   },
   "expect_hits_match": "(?i)(^|[^\\pL\\pN])graph[^\\pL\\pN]+ingest[^\\pL\\pN]+query([^\\pL\\pN]|$)",
   "why": "A dotted subject as a phrase: its three parts in order."
  },
  {
   "id": "P05",
   "band": "phrase",
   "args": {
    "query": "\"time.Sleep\"",
    "limit": 0
   },
   "expect_hits_match": "(?i)(^|[^\\pL\\pN])time[^\\pL\\pN]+sleep([^\\pL\\pN]|$)",
   "why": "A dotted Go name as a phrase."
  },
  {
   "id": "P06",
   "band": "phrase",
   "args": {
    "query": "\"t.Parallel\"",
    "limit": 0
   },
   "expect_hits_match": "(?i)(^|[^\\pL\\pN])t[^\\pL\\pN]+parallel([^\\pL\\pN]|$)",
   "why": "A one-letter part is a word, so the phrase needs it."
  },
  {
   "id": "P07",
   "band": "phrase",
   "args": {
    "query": "\"retry classified\"",
    "limit": 0
   },
   "expect_hits_match": "(?i)retry[^\\pL\\pN]*classified",
   "why": "The parts of RequestWithRetryClassified are held as words; with is a stopword, so retry and classified stand next to each other."
  },
  {
   "id": "P08",
   "band": "phrase",
   "args": {
    "query": "\"quantum entanglement subsystem\""
   },
   "expect_no_hits": true,
   "why": "A phrase no section holds finds nothing."
  },
  {
   "id": "I01",
   "band": "identifier",
   "twin": "P07",
   "args": {
    "query": "withretry"
   },
   "expect_no_hits": true,
   "why": "A joined identifier is not held: withRetry is held as retry alone, so its run-together spelling finds nothing."
  },
  {
   "id": "I02",
   "band": "identifier",
   "args": {
    "query": "RequestWithRetryClassified"
   },
   "expect_top_all": [
    "RequestWithRetryClassified"
   ],
   "why": "An identifier typed whole is split as the text was, so the sections naming it rank first."
  },
  {
   "id": "I03",
   "band": "identifier",
   "args": {
    "query": "ValidateEntityID"
   },
   "expect_any": [
    "ValidateEntityID"
   ],
   "why": "An identifier typed whole finds the sections naming it."
  },
  {
   "id": "I04",
   "band": "identifier",
   "twin": "I03",
   "args": {
    "query": "validate entity id"
   },
   "expect_any": [
    "ValidateEntityID"
   ],
   "why": "The words of an identifier, typed apart, find the sections naming it."
  },
  {
